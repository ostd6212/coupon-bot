# Токен НОВОГО бота від @BotFather (не токен бота для вчителів!)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Ключ з console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Telegram user id через кому (ваш і дружини; дізнатися: @userinfobot). Решту бот ігнорує.
ALLOWED_USER_IDS=111111111,222222222
# Модель для розпізнавання. Якщо погано читає: claude-sonnet-5-5
CLAUDE_MODEL=claude-haiku-5-5
TZ=Europe/Madrid
# О котрій ранкові нагадування, і о котрій вечірнє (напередодні коротких акцій)
REMINDER_HOUR=9
# EVENING_HOUR=19
# Де лежать база, фото й логи (за замовчуванням ./data)
# DATA_DIR=data
